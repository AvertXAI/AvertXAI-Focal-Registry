{
  "name": "avertxai-focal-registry",
  "productName": "Focal Registry",
  "version": "0.2.6",
  "private": true,
  "description": "Photography Archive Tools",
  "author": "AvertXAI",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts electron/preload.ts electron/update-preload.ts electron/mini-preload.ts --bundle --platform=node --external:electron --external:better-sqlite3-multiple-ciphers --external:argon2 --outdir=dist-electron --format=cjs --out-extension:.js=.cjs",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "npm run build && electron .",
    "dev:reset": "node scripts/reset.mjs && npm run dev",
    "dev:diag": "set DIAG=1&& npm run dev",
    "package": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win && node scripts/release.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers,argon2"
  },
  "build": {
    "appId": "com.avertxai.focalregistry",
    "artifactName": "Focal-Registry-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.focalregistry.com/prerelease",
        "channel": "prerelease"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "dist-electron/update-preload.cjs",
      "dist-electron/mini-preload.cjs",
      "build/icon.ico",
      "assets/sounds/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3-multiple-ciphers/**",
      "node_modules/argon2/**"
    ],
    "compression": "maximum",
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AvertXAI Focal Registry"
    },
    "portable": {
      "artifactName": "Focal-Registry-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "music-metadata": "^11.14.0"
  }
}
